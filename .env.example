# ==============================================================================
# SprintSync - Root Docker & Application Environment Variables (.env.example)
# Duplicate this file as '.env' for local Docker Compose execution.
# ==============================================================================

# --- Django Security ---
DEBUG=False
SECRET_KEY=replace_with_a_secure_random_64_char_key_for_production
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend

# --- PostgreSQL Database Credentials ---
DB_NAME=project_management_db
DB_USER=postgres
DB_PASSWORD=replace_with_secure_database_password
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql://postgres:replace_with_secure_database_password@db:5432/project_management_db

# --- Redis & Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# --- Cross-Origin & CSRF Policies ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost,http://127.0.0.1:5173,http://127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost,http://127.0.0.1:5173,http://127.0.0.1

# --- Frontend Build Parameters ---
# Leave blank for Nginx relative reverse-proxy (/api/); or set explicitly to http://localhost:8000
VITE_API_URL=

# --- Outbound Email (SMTP) Settings ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=SprintSync <no-reply@sprintsync.local>

# --- Stripe Test Mode Integration ---
STRIPE_SECRET_KEY=sk_test_replace_with_test_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_test_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_webhook_signing_secret
STRIPE_SUCCESS_URL=http://localhost:5173/billing/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:5173/billing/cancel

# --- Webhook Dispatcher Security ---
WEBHOOK_ALLOW_LOCAL_DESTINATIONS=False

