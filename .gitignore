# Root .gitignore for SprintSync

# Environment variables & secrets
.env
.env.*
!.env.example
!backend/.env.example
!frontend/.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml

# Django Static & Media
backend/staticfiles/
backend/media/
!backend/media/.gitkeep

# Node & Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
frontend/dist/
frontend/node_modules/

# Operating System & Editors
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# Docker state & Celery schedules
celerybeat-schedule
celerybeat.pid
*.log
tmp/
temp/

# Submission archives
SprintSync_Drive_Submission/
SprintSync_Submission.zip
*.zip

